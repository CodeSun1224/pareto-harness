{"$defs":{"TaskId":{"description":"Task identifier within one run lifecycle.","maxLength":128,"minLength":6,"pattern":"^task_[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$","type":"string"},"TaskState":{"description":"Authoritative state of a Task owned by one Run lifecycle.","oneOf":[{"const":"created","description":"The task exists but is not ready to run.","maxLength":262144,"type":"string"},{"const":"ready","description":"The task is ready to be scheduled.","maxLength":262144,"type":"string"},{"const":"running","description":"The task is actively executing.","maxLength":262144,"type":"string"},{"const":"paused","description":"The task is explicitly paused.","maxLength":262144,"type":"string"},{"const":"succeeded","description":"The task completed successfully.","maxLength":262144,"type":"string"},{"const":"failed","description":"The task completed with failure.","maxLength":262144,"type":"string"},{"const":"cancelled","description":"The task was cancelled.","maxLength":262144,"type":"string"}]}},"$id":"urn:pareto-harness:schema:task-state-transitioned-payload:1.0","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"description":"Payload recording one authoritative Task state transition.","properties":{"from":{"$ref":"#/$defs/TaskState","description":"Folded state before the transition."},"reason_code":{"description":"Stable non-empty reason code fixed by the command.","maxLength":262144,"minLength":1,"type":"string"},"task_id":{"$ref":"#/$defs/TaskId","description":"Target Task within the lifecycle aggregate."},"to":{"$ref":"#/$defs/TaskState","description":"Requested state after the transition."}},"required":["task_id","from","to","reason_code"],"title":"TaskStateTransitionedPayload","type":"object","unevaluatedProperties":false}
