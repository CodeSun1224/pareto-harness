{"$defs":{"AgentId":{"description":"Agent or actor identifier.","maxLength":128,"minLength":7,"pattern":"^agent_[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$","type":"string"},"Digest":{"description":"Lowercase SHA-256 digest in the wire form `sha256:<64 hex>`.","maxLength":71,"minLength":71,"pattern":"^sha256:[0-9a-f]{64}$","type":"string"},"EvidenceVerdict":{"description":"Structured evidence verdict; natural language cannot introduce a passing state.","oneOf":[{"const":"passed","description":"Evidence proves the claim under its stated scope.","maxLength":262144,"type":"string"},{"const":"failed","description":"Evidence disproves the claim.","maxLength":262144,"type":"string"},{"const":"inconclusive","description":"Evidence cannot decide the claim.","maxLength":262144,"type":"string"},{"const":"invalidated","description":"Evidence is no longer admissible.","maxLength":262144,"type":"string"}]},"IsolationScope":{"additionalProperties":false,"description":"Exact isolation keys carried by authoritative records.","properties":{"agent_id":{"$ref":"#/$defs/AgentId","description":"Required agent/actor boundary."},"run_id":{"$ref":"#/$defs/RunId","description":"Required run boundary."},"tenant_id":{"$ref":"#/$defs/TenantId","description":"Required tenant boundary."},"user_id":{"$ref":"#/$defs/UserId","description":"Exact optional authenticated user."},"workspace_id":{"$ref":"#/$defs/WorkspaceId","description":"Required workspace boundary."}},"required":["tenant_id","workspace_id","run_id","agent_id"],"type":"object"},"RequirementId":{"description":"Requirement identifier.","maxLength":128,"minLength":5,"pattern":"^req_[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$","type":"string"},"RevisionId":{"description":"Immutable revision identifier.","maxLength":128,"minLength":5,"pattern":"^rev_[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$","type":"string"},"RunId":{"description":"Run identifier.","maxLength":128,"minLength":5,"pattern":"^run_[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$","type":"string"},"SchemaRef":{"additionalPr