{"$defs":{"AgentId":{"description":"Agent or actor identifier.","maxLength":128,"minLength":7,"pattern":"^agent_[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$","type":"string"},"BoundaryRecordingPolicyRef":{"additionalProperties":false,"description":"Versioned policy describing which nondeterministic boundaries are recorded.","properties":{"digest":{"$ref":"#/$defs/Digest","description":"Policy content digest."},"revision_id":{"$ref":"#/$defs/RevisionId","description":"Immutable policy revision."}},"required":["revision_id","digest"],"type":"object"},"Digest":{"description":"Lowercase SHA-256 digest in the wire form `sha256:<64 hex>`.","maxLength":71,"minLength":71,"pattern":"^sha256:[0-9a-f]{64}$","type":"string"},"ExecutionMode":{"description":"Run execution and replay lineage contract.","oneOf":[{"additionalProperties":false,"description":"First live execution; it cannot claim a source run.","properties":{"mode":{"const":"live","maxLength":262144,"type":"string"}},"required":["mode"],"type":"object"},{"additionalProperties":false,"description":"Replay using a finalized source recording.","properties":{"boundary_inventory_revision":{"$ref":"#/$defs/RevisionId","description":"Finalized boundary inventory used by this replay."},"mode":{"const":"recorded_replay","maxLength":262144,"type":"string"},"source_run_id":{"$ref":"#/$defs/RunId","description":"Completed source run."}},"required":["mode","source_run_id","boundary_inventory_revision"],"type":"object"},{"additionalProperties":false,"description":"Re-execution compared against a finalized source recording.","properties":{"boundary_inventory_revision":{"$ref":"#/$defs/RevisionId","description":"Finalized boundary inventory used for comparison."},"mode":{"const":"reexecute","maxLength":262144,"type":"string"},"source_run_id":{"$ref":"#/$defs/RunId","description":"Completed source run."}},"required":["mode","source_run_id","boundary_inventory_revision"],"type":"object"},{"additionalProperties":false,"description":"Deterministic f