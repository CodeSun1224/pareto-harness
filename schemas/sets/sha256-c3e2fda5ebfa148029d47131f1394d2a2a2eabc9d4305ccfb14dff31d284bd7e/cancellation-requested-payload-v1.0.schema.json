{"$defs":{"AgentId":{"description":"Agent or actor identifier.","maxLength":128,"minLength":7,"pattern":"^agent_[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$","type":"string"},"CancellationId":{"description":"Cancellation request identifier.","maxLength":128,"minLength":8,"pattern":"^cancel_[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$","type":"string"},"CancellationTargetV1":{"description":"Cancellation target.","oneOf":[{"additionalProperties":false,"description":"Entire Run.","properties":{"kind":{"const":"run","maxLength":262144,"type":"string"}},"required":["kind"],"type":"object"},{"additionalProperties":false,"description":"Exact Task and descendants' operations.","properties":{"kind":{"const":"task","maxLength":262144,"type":"string"},"task_id":{"$ref":"#/$defs/TaskId","description":"Task identity."}},"required":["kind","task_id"],"type":"object"},{"additionalProperties":false,"description":"Exact operation only.","properties":{"kind":{"const":"operation","maxLength":262144,"type":"string"},"operation_id":{"$ref":"#/$defs/OperationId","description":"Operation identity."}},"required":["kind","operation_id"],"type":"object"}]},"EventCursor":{"additionalProperties":false,"description":"Inclusive position of one authoritative event in a lifecycle stream.","properties":{"event_id":{"$ref":"#/$defs/EventId","description":"Exact event at the inclusive sequence."},"sequence":{"description":"Positive canonical decimal stream sequence.","maxLength":128,"minLength":1,"pattern":"^[1-9][0-9]*$","type":"string"}},"required":["sequence","event_id"],"type":"object"},"EventId":{"description":"Event identifier.","maxLength":128,"minLength":7,"pattern":"^event_[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$","type":"string"},"LifecycleAdmissionV1":{"additionalProperties":false,"description":"Authoritative reservation payload.","properties":{"cursor":{"$ref":"#/$defs/EventCursor","description":"Exact lifecycle event admitted before reservation."},"run_state":{"$ref":"#/$defs/RunState","description":"Run state observed at the exact cursor."},"task_state":{"$ref":"#/$defs/TaskState","description":"Task state observed at the exact cursor for Task-scoped operations."}},"required":["cursor","run_state"],"type":"object"},"OperationId":{"description":"Protected operation identifier.","maxLength":128,"minLength":11,"pattern":"^operation_[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$","type":"string"},"RunState":{"description":"Authoritative state of a Run lifecycle aggregate.","oneOf":[{"const":"created","description":"Manifest is fixed but execution has not started.","maxLength":262144,"type":"string"},{"const":"running","description":"The run is actively executing.","maxLength":262144,"type":"string"},{"const":"paused","description":"The run is explicitly paused.","maxLength":262144,"type":"string"},{"const":"succeeded","description":"The run completed successfully.","maxLength":262144,"type":"string"},{"const":"failed","description":"The run completed with failure.","maxLength":262144,"type":"string"},{"const":"cancelled","description":"The run was cancelled.","maxLength":262144,"type":"string"}]},"TaskId":{"description":"Task identifier within one run lifecycle.","maxLength":128,"minLength":6,"pattern":"^task_[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$","type":"string"},"TaskState":{"description":"Authoritative state of a Task owned by one Run lifecycle.","oneOf":[{"const":"created","description":"The task exists but is not ready to run.","maxLength":262144,"type":"string"},{"const":"ready","description":"The task is ready to be scheduled.","maxLength":262144,"type":"string"},{"const":"running","description":"The task is actively executing.","maxLength":262144,"type":"string"},{"const":"paused","description":"The task is explicitly paused.","maxLength":262144,"type":"string"},{"const":"succeeded","description":"The task completed successfully.","maxLength":262144,"type":"string"},{"const":"failed","description":"The task completed with failure.","maxLength":262144,"type":"string"},{"const":"cancelled","description":"The task was cancelled.","maxLength":262144,"type":"string"}]}},"$id":"urn:pareto-harness:schema:cancellation-requested-payload:1.0","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"description":"Cancellation request payload.","properties":{"cancellation_id":{"$ref":"#/$defs/CancellationId","description":"Cancellation identity."},"lifecycle_admission":{"$ref":"#/$defs/LifecycleAdmissionV1","description":"Exact lifecycle checkpoint at cancellation admission."},"reason_code":{"description":"Stable reason.","maxLength":262144,"minLength":1,"type":"string"},"requested_at_utc":{"description":"Canonical UTC request time.","maxLength":262144,"type":"string"},"requester":{"$ref":"#/$defs/AgentId","description":"Authorized requester."},"target":{"$ref":"#/$defs/CancellationTargetV1","description":"Exact target."}},"required":["cancellation_id","requester","target","lifecycle_admission","reason_code","requested_at_utc"],"title":"CancellationRequestedPayloadV1","type":"object","unevaluatedProperties":false}
