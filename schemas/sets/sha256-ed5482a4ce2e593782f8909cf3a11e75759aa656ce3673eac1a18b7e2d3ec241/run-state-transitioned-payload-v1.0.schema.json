{"$defs":{"RunState":{"description":"Authoritative state of a Run lifecycle aggregate.","oneOf":[{"const":"created","description":"Manifest is fixed but execution has not started.","maxLength":262144,"type":"string"},{"const":"running","description":"The run is actively executing.","maxLength":262144,"type":"string"},{"const":"paused","description":"The run is explicitly paused.","maxLength":262144,"type":"string"},{"const":"succeeded","description":"The run completed successfully.","maxLength":262144,"type":"string"},{"const":"failed","description":"The run completed with failure.","maxLength":262144,"type":"string"},{"const":"cancelled","description":"The run was cancelled.","maxLength":262144,"type":"string"}]}},"$id":"urn:pareto-harness:schema:run-state-transitioned-payload:1.0","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"description":"Payload recording one authoritative Run state transition.","properties":{"from":{"$ref":"#/$defs/RunState","description":"Folded state before the transition."},"reason_code":{"description":"Stable non-empty reason code fixed by the command.","maxLength":262144,"minLength":1,"type":"string"},"to":{"$ref":"#/$defs/RunState","description":"Requested state after the transition."}},"required":["from","to","reason_code"],"title":"RunStateTransitionedPayload","type":"object","unevaluatedProperties":false}
