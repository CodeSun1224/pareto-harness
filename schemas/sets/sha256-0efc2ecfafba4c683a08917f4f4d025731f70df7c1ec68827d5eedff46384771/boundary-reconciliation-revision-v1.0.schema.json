{"$defs":{"AgentId":{"description":"Agent or actor identifier.","maxLength":128,"minLength":7,"pattern":"^agent_[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$","type":"string"},"Digest":{"description":"Lowercase SHA-256 digest in the wire form `sha256:<64 hex>`.","maxLength":71,"minLength":71,"pattern":"^sha256:[0-9a-f]{64}$","type":"string"},"EventId":{"description":"Event identifier.","maxLength":128,"minLength":7,"pattern":"^event_[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$","type":"string"},"RevisionId":{"description":"Immutable revision identifier.","maxLength":128,"minLength":5,"pattern":"^rev_[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$","type":"string"},"RevisionMetadata":{"additionalProperties":false,"description":"Immutable metadata shared by revisions.","properties":{"content_digest":{"$ref":"#/$defs/Digest","description":"Digest of the behavior content hash view."},"created_at":{"description":"Canonical UTC RFC 3339 millisecond time.","maxLength":24,"minLength":24,"pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$","type":"string"},"creator_actor":{"$ref":"#/$defs/AgentId","description":"Actor that created the revision."},"logical_id":{"description":"Stable logical identifier.","maxLength":262144,"minLength":1,"type":"string"},"parent_revision":{"$ref":"#/$defs/RevisionId","description":"Optional same-kind parent."},"revision_id":{"$ref":"#/$defs/RevisionId","description":"Content and metadata-derived revision identifier."},"revision_kind":{"description":"Revision kind used for digest domain separation.","maxLength":262144,"minLength":1,"type":"string"},"schema_ref":{"$ref":"#/$defs/SchemaRef","description":"Wire schema used by this revision."},"source":{"description":"Source classification or reference.","maxLength":262144,"minLength":1,"type":"string"}},"required":["logical_id","revision_id","revision_kind","schema_ref","content_digest","creator_actor","source","created_at"],"type":"object"},"SchemaRef":{"additionalProperties":false,"description":"Complete, immutable schema identity.","properties":{"major":{"format":"uint32","minimum":0,"type":"integer"},"minor":{"format":"uint32","minimum":0,"type":"integer"},"schema_digest":{"$ref":"#/$defs/Digest"},"type":{"maxLength":128,"minLength":1,"pattern":"^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$","type":"string"}},"required":["type","major","minor","schema_digest"],"type":"object"}},"$id":"urn:pareto-harness:schema:boundary-reconciliation-revision:1.0","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"description":"Reconciliation of audit facts that arrived after inventory finalization.","properties":{"hash_schema_ref":{"$ref":"#/$defs/SchemaRef","description":"Exact Schema for the immutable reconciliation content hash preimage."},"inventory_revision":{"$ref":"#/$defs/RevisionId","description":"Inventory being reconciled without mutation."},"late_result_events":{"description":"Ordered late-result audit events.","items":{"$ref":"#/$defs/EventId"},"maxItems":16384,"type":"array"},"metadata":{"$ref":"#/$defs/RevisionMetadata","description":"Reconciliation revision metadata."}},"required":["metadata","hash_schema_ref","inventory_revision","late_result_events"],"title":"BoundaryReconciliationRevision","type":"object","unevaluatedProperties":false}
